# AlloPrint — Apache 2.4 (cPanel / XAMPP)
# Adresses propres : /services, /contact, /devis, /articles, /article/mon-article, /login, /admin/…
DirectoryIndex index.html index.php
Options -Indexes -MultiViews
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest

# Fichiers internes jamais servis (fichiers cachés, données, docs, routeur de dev)
<FilesMatch "(?i)(^\.|\.(json|ini|log|md|bak|tmp|sql|ps1|py)$|^router\.php$|^LICENSE$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On

# Chemin de base (racine du domaine ou sous-dossier XAMPP)
RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
RewriteRule ^(.*)$ - [E=BASE:%1]

# Production uniquement : HTTPS et domaine sans « www » (localhost n'est pas concerné)
RewriteCond %{HTTP_HOST} ^(?:www\.)?alloprint\.ma$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.alloprint\.ma$ [NC]
RewriteRule ^ https://alloprint.ma%{REQUEST_URI} [R=301,L,NE]

# Dossiers internes et scripts interdits dans uploads/
RewriteRule ^(?:data|inc|admin/inc)(?:/|$) - [F,L,NC]
RewriteRule ^uploads/.*\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh|html?|svg)$ - [F,L,NC]

# Sitemap
RewriteRule ^site\.xml$ %{ENV:BASE}sitemap.xml [R=301,L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Fichier de validation Google Search Console : servi tel quel, sans redirection
RewriteRule ^google[0-9a-f]+\.html$ - [L]

# --- Ancien site alloprint.ma (www, .html / .php) : 301 vers la page équivalente ---
RewriteRule ^(?:index-2\.html|indexe?\.php|index-\.php)$ %{ENV:BASE} [R=301,L]
RewriteRule ^(?:contacte?\.php|rappel\.php)$ %{ENV:BASE}contact [R=301,L]
RewriteRule ^(?:demande-devis\.php|Devis\.php|devis111\.php)$ %{ENV:BASE}devis [R=301,L]
RewriteRule ^(?:service\.html|services\.php)$ %{ENV:BASE}services [R=301,L]
RewriteRule ^(?:presentation\.html|imprimerie\.html|references\.php|Copie\ de\ references\.php)$ %{ENV:BASE}notre-imprimerie [R=301,L]
RewriteRule ^blog\.html$ %{ENV:BASE}articles [R=301,L]
RewriteRule ^conception-graphique\.html$ %{ENV:BASE}design-graphique [R=301,L]
RewriteRule ^(?:stand|agencement-magasins)\.html$ %{ENV:BASE}stands-exposition [R=301,L]
RewriteRule ^palissades-de-chantier\.html$ %{ENV:BASE}palissade-chantier [R=301,L]
RewriteRule ^impresson-grand-format\.html$ %{ENV:BASE}impression-grand-format [R=301,L]
RewriteRule ^impression-numerique-vinyles\.html$ %{ENV:BASE}impression-vinyle [R=301,L]
RewriteRule ^impression-numerique-baches\.(?:html|php)$ %{ENV:BASE}impression-bache [R=301,L]
RewriteRule ^impression-numerique-(?:posters|pvc|toile|papier-peint|supports)\.html$ %{ENV:BASE}impression-grand-format [R=301,L]
RewriteRule ^impression-numerique-tirage-plan\.html$ %{ENV:BASE}impression-numerique [R=301,L]
RewriteRule ^impression-offset-autocollant\.html$ %{ENV:BASE}impression-vinyle [R=301,L]
RewriteRule ^(?:impression-offset-(?:plv|plv-plastique|cadeau)|plv|publicite-par-objet|enseigne-publicitaire)\.html$ %{ENV:BASE}industrie-publicitaire [R=301,L]
RewriteRule ^impression-offset(?:-[a-z_-]+)?\.html$ %{ENV:BASE}impression-numerique [R=301,L]
RewriteRule ^(?:conception_et_impression_(?:carte_de_visite|flyers)\.html|impression_(?:carte_de_visite|depliant|flyers)\.php)$ %{ENV:BASE}impression-numerique [R=301,L]

# --- Redirections 301 des anciennes adresses (GET) vers les adresses propres ---
RewriteRule ^impression-lettrage(?:\.html)?$ %{ENV:BASE}impression-vitrine [R=301,L]
RewriteRule ^index\.php$ %{ENV:BASE} [R=301,L]

RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} \s[^?\s]*/index\.html[\s?]
RewriteRule ^(.*/)?index\.html$ %{ENV:BASE}$1 [R=301,L]

RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} \s[^?\s]*\.html[\s?]
RewriteRule ^(.+)\.html$ %{ENV:BASE}$1 [R=301,L]

RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} \s[^?\s]*/article\.php\?slug=([a-z0-9-]+)[\s&]
RewriteRule ^article\.php$ %{ENV:BASE}article/%1? [R=301,L]

RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} \s[^?\s]*/articles\.php[\s?]
RewriteRule ^articles\.php$ %{ENV:BASE}articles [R=301,L]

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s[^?\s]*/sitemap\.php[\s?]
RewriteRule ^sitemap\.php$ %{ENV:BASE}sitemap.xml [R=301,L]

RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} \s[^?\s]*/admin/login\.php[\s?]
RewriteRule ^admin/login\.php$ %{ENV:BASE}login [R=301,L,QSA]

# Barre finale retirée (/services/ → /services), sauf vrais dossiers
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ %{ENV:BASE}$1 [R=301,L]

# --- Adresse propre → fichier ---
RewriteRule ^login/?$ admin/login.php [L,QSA]
RewriteRule ^article/([a-z0-9-]+)/?$ article.php?slug=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L,QSA]

# Page 404 dans le même dossier : fonctionne aussi sous /site/.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.php [L]
</IfModule>

# En-têtes de sécurité
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Pages d'administration et API jamais indexées
    <If "%{REQUEST_URI} =~ m#/(admin|api|login)(/|$)#">
        Header always set X-Robots-Tag "noindex, nofollow"
    </If>
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

# Cache navigateur (les icônes et le CSS ont un paramètre de version quand ils changent)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType image/vnd.microsoft.icon "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
