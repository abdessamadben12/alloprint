# AlloPrint — adresses propres (sans .html / .php)
#   /services, /contact, /devis…  → pages .html
#   /articles, /article/mon-article → articles PHP
#   /login                          → connexion à l'administration
#   /admin/…                        → pages de l'administration
Options -MultiViews -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Chemin de base du site (fonctionne à la racine du domaine comme dans un sous-dossier XAMPP)
RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
RewriteRule ^(.*)$ - [E=BASE:%1]

# --- Redirections 301 des anciennes adresses vers les adresses propres (requêtes GET uniquement) ---
RewriteRule ^impression-lettrage(\.html)?$ %{ENV:BASE}impression-vitrine [R=301,L]

RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} \s[^?\s]*/index\.html[\s?]
RewriteRule ^(.*/)?index\.html$ %{ENV:BASE}$1 [R=301,L]

RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} \s[^?\s]*\.html[\s?]
RewriteRule ^(.+)\.html$ %{ENV:BASE}$1 [R=301,L]

RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} \s[^?\s]*/article\.php\?slug=([a-z0-9-]+)[\s&]
RewriteRule ^article\.php$ %{ENV:BASE}article/%1? [R=301,L]

RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} \s[^?\s]*/articles\.php[\s?]
RewriteRule ^articles\.php$ %{ENV:BASE}articles [R=301,L]

RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} \s[^?\s]*/admin/login\.php[\s?]
RewriteRule ^admin/login\.php$ %{ENV:BASE}login [R=301,L,QSA]

# Retire la barre finale sur les pages (ex. /services/ → /services), sauf vrais dossiers
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ %{ENV:BASE}$1 [R=301,L]

# --- Correspondances adresse propre → fichier ---
RewriteRule ^login/?$ admin/login.php [L,QSA]
RewriteRule ^article/([a-z0-9-]+)/?$ article.php?slug=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L,QSA]
</IfModule>

# Fichiers sensibles jamais servis
<FilesMatch "^(ADMIN\.md|CREDITS\.md|LICENSE|.*\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
